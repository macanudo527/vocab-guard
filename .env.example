# Variable names only. Copy to .env and fill in. Never commit .env.
# Generate random values with: openssl rand -hex 24

# Optional. When set, POST /check requires an X-API-Key header with this value.
CHECKER_API_KEY=

# Required. Encrypts the credentials n8n stores. Keep it stable: changing it
# makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# Required for the demo profile (WordPress + MariaDB).
WORDPRESS_DB_NAME=
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Demo WordPress admin account, created on first start. Log in at
# http://localhost:8080/wp-admin.
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=

# Optional host ports (defaults: 8000, 5678, 8080).
CHECKER_PORT=
N8N_PORT=
WORDPRESS_PORT=
